# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_URL: Public canonical base URL for SEO canonical tags, OpenGraph og:url, sitemap.xml, robots.txt, and CORS allowlist.
# Example: https://YOUR-DOMAIN.com (no trailing slash)
SITE_URL="https://YOUR-DOMAIN.com"

# VITE_RECAPTCHA_SITE_KEY: Optional Firebase App Check reCAPTCHA v3 site key for form protection (quotations, contact, newsletter).
# When omitted, forms remain functional with server-side honeypot, Zod validation, and rate limiting.
VITE_RECAPTCHA_SITE_KEY=""

# GCS_BUCKET: Google Cloud Storage private bucket name for persistent file uploads.
# When omitted, /api/files/upload returns HTTP 503 STORAGE_NOT_CONFIGURED instead of writing local disk files.
GCS_BUCKET=""

# ADMIN_EMAIL: Target user email used ONLY by the local provisioning CLI (`ADMIN_EMAIL=... npx tsx scripts/create-admin.ts`)
# to grant the initial `admin` role in Firestore `user_roles/{uid}` and custom claims. Not read at runtime by server.ts.
ADMIN_EMAIL=""

# PAYMENT_SECRET: HMAC-SHA256 signing secret for server-verified payment intents.
# Configure a high-entropy 32+ byte secret in Cloud Run / environment secrets.
PAYMENT_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"

# PAYMENT_WEBHOOK_SECRET: Separate 32+ byte HMAC secret used to verify authentic payment gateway settlement callbacks.
PAYMENT_WEBHOOK_SECRET=""

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional Firebase Admin service account JSON (for local dev outside GCP ADC).
# In Cloud Run, attach a minimal-privilege IAM Service Account instead of embedding raw keys.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# CORS_ALLOWED_ORIGINS: Optional comma-separated list of additional trusted origins beyond SITE_URL.
CORS_ALLOWED_ORIGINS=""

# VITE_FIREBASE_MEASUREMENT_ID: Optional GA4 Measurement ID (e.g. G-XXXXXXXXXX) for production Firebase Analytics.
VITE_FIREBASE_MEASUREMENT_ID=""

# FORM_RATE_LIMIT_MAX: Optional max form submissions per IP per 15-minute window (default: 8).
FORM_RATE_LIMIT_MAX="8"

# TRUST_PROXY_HOPS: Reverse-proxy hop count for Express req.ip (default: 1 for Google Cloud Run).
TRUST_PROXY_HOPS="1"

# ENFORCE_APP_CHECK: Set to "true" in Cloud Run once VITE_RECAPTCHA_SITE_KEY is configured to fail closed on missing App Check.
ENFORCE_APP_CHECK="false"

# STRICT_PRODUCTION_ENV: Set to "true" in Cloud Run to fail container startup if required production env vars are missing/invalid.
STRICT_PRODUCTION_ENV="false"

