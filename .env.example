# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PAYMENT_SECRET: HMAC-SHA256 signing secret for server-verified payment intents.
# Configure a high-entropy 32+ byte secret in Cloud Run / environment secrets.
PAYMENT_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"

# GCS_BUCKET: Optional Google Cloud Storage private bucket name for persistent file storage.
# When omitted, /api/files/upload returns HTTP 503 STORAGE_NOT_CONFIGURED instead of writing unpersisted local files.
GCS_BUCKET=""

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional Firebase Admin service account JSON (for local dev outside GCP ADC).
# In Cloud Run, attach a minimal-privilege IAM Service Account instead of embedding raw keys.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# CORS_ALLOWED_ORIGINS: Optional comma-separated list of additional trusted origins.
CORS_ALLOWED_ORIGINS=""

# VITE_FIREBASE_MEASUREMENT_ID: Optional GA4 Measurement ID (e.g. G-XXXXXXXXXX) for production Firebase Analytics.
VITE_FIREBASE_MEASUREMENT_ID=""

# ROOT_ADMIN_EMAIL: Optional root administrator email (or comma-separated emails) read by server.ts.
# Primary admin access should be granted via the Firestore `user_roles` collection (`user_roles/{uid}` with `role: "admin"`).
# Leave empty to use Firestore `user_roles` + backward-compatible legacy bootstrap fallback.
# Example: ROOT_ADMIN_EMAIL="admin@yourdomain.com"
ROOT_ADMIN_EMAIL=""

# FORM_RATE_LIMIT_MAX: Optional max form submissions per IP per 15-minute window (default: 8).
FORM_RATE_LIMIT_MAX="8"

