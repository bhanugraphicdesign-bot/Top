# ==============================================================================
# POWER WEB STUDIO AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Separate profiles for Google AI Studio Preview vs Dedicated Cloud Run Production.
# NEVER store Service Account Private Keys or secrets in source code or frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE (preview | production)
# ------------------------------------------------------------------------------
# - Preview (Google AI Studio): APP_ENV="preview", NODE_ENV="development"
#   Shared ais-sandbox service account receives ZERO extra IAM permissions.
#   Admin backend routes verify Firebase ID tokens and enforce Firestore rules.
# - Production (Published Cloud Run): APP_ENV="production", NODE_ENV="production"
#   Attach a dedicated Runtime Service Account to Cloud Run with least-privilege IAM
#   (roles/datastore.user and, only if syncing Auth custom claims, roles/firebaseauth.admin).
#   Firebase Admin SDK initializes strictly via Application Default Credentials (ADC).
APP_ENV="preview"
NODE_ENV="development"
STRICT_PRODUCTION_ENV="false"

# ------------------------------------------------------------------------------
# 2. PUBLIC SITE URL & CORS ALLOWLIST
# ------------------------------------------------------------------------------
# Production canonical origin (no trailing slash). Example: https://yourdomain.com
SITE_URL="https://YOUR-DOMAIN.com"

# Comma-separated additional trusted origins beyond same-origin and SITE_URL.
# Keep Preview and Production origins separated per environment.
CORS_ALLOWED_ORIGINS=""

# Reverse-proxy hop count for Express req.ip (default: 1 for Google Cloud Run).
TRUST_PROXY_HOPS="1"

# ------------------------------------------------------------------------------
# 3. SUPER ADMIN ONE-TIME BOOTSTRAP (PRODUCTION SERVER-ONLY)
# ------------------------------------------------------------------------------
# Authorized owner Gmail verified via Firebase Auth for one-time Super Admin bootstrap.
SUPER_ADMIN_EMAIL="powerusertopuser@gmail.com"

# One-time high-entropy secret (>= 32 chars) stored ONLY in Cloud Run Secret Manager / env.
# Used by POST /api/admin/super-admin/bootstrap in Production mode (permanently locked after 1st use).
ADMIN_BOOTSTRAP_SECRET=""

# Target user email used ONLY by the ADC-based CLI (`ADMIN_EMAIL=... npx tsx scripts/create-admin.ts`).
ADMIN_EMAIL=""

# ------------------------------------------------------------------------------
# 4. AI, PAYMENTS, STORAGE & APP CHECK
# ------------------------------------------------------------------------------
# Gemini AI API key (injected via server secrets; never exposed in frontend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# High-entropy 32+ byte HMAC secrets for server-verified payment intents and webhooks.
PAYMENT_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"
PAYMENT_WEBHOOK_SECRET=""

# Private Google Cloud Storage bucket for persistent file uploads (uses Cloud Run ADC).
GCS_BUCKET=""

# Optional Firebase App Check reCAPTCHA v3 site key and enforcement mode.
VITE_RECAPTCHA_SITE_KEY=""
ENFORCE_APP_CHECK="false"

# Server-side Google Cloud reCAPTCHA Enterprise API key (never expose to frontend).
RECAPTCHA_API_KEY=""

# Optional GA4 Measurement ID (e.g. G-FYEH0TXXPB).
VITE_FIREBASE_MEASUREMENT_ID=""

# Max form submissions per IP per 15-minute window (default: 8).
FORM_RATE_LIMIT_MAX="8"
