rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ssbhanu41@gmail.com' ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. User Roles Collection (Strict Admin-Only Mutation)
    match /user_roles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. User Profiles Collection
    match /user_profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Apps Catalog (Public Read, Admin Write)
    match /apps/{appId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. App Categories
    match /app_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 6. Projects Collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 7. Project Tasks
    match /project_tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 8. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.clientId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 9. Quotations / Scoping Inquiries
    match /quotations/{quotationId} {
      allow get: if isSignedIn() && (resource.data.clientEmail == request.auth.token.email || isAdmin());
      allow list: if isAdmin();
      allow create: if true; // Allow inbound consultation submissions
      allow update, delete: if isAdmin();
    }

    // 10. Invoices Collection
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 11. Payments Collection
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 12. Support Tickets
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 13. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 14. Audit Logs (Immutable, Admin Read)
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if true; // System & client event logger
      allow update, delete: if false; // Strict immutability
    }

    // 15. Site Settings
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. Services Catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 17. Blog Posts (Content Management)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection Health Verification Probe
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
